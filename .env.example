# Copy to .env and adjust.

# PostgreSQL in production (docker-compose sets this for you). SQLite works for a quick trial.
DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5432/inventory
# DATABASE_URL=sqlite:///./inventory.db

# Needed only for the Assistant tab / `ask` command.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium

# If set, every /api call must send this token (the dashboard asks for it once).
APP_TOKEN=

# Forecast and replenishment policy
HISTORY_DAYS=182
SERVICE_LEVEL_A=0.98
SERVICE_LEVEL_B=0.95
SERVICE_LEVEL_C=0.90
REVIEW_PERIOD_DAYS=7
ORDER_CYCLE_DAYS=30
TRANSFER_LEAD_DAYS=3
DEFAULT_SUPPLIER_LEAD_DAYS=45
DONOR_KEEP_DAYS=60
BRANCH_RANGE_MIN_SALE_DAYS=3
MIN_TRANSFER_VALUE=100
USD_TO_SAR=3.75

# Alerts
DEAD_STOCK_DAYS=180
SPIKE_WINDOW_DAYS=7
SPIKE_SIGMA=4
SHRINKAGE_MIN_VALUE=200
